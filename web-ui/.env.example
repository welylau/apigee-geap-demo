# Optional overrides for run-local.sh (copy to .env; gitignored, chmod 600). Never commit .env.
# Keys are normally pulled from Secret Manager at start-up (cymbal-ge-demo-webui-key, cymbal-ge-demo-partner-key).
PROJECT_ID=YOUR_PROJECT_ID
REGION=asia-southeast1
APIGEE_HOST=YOUR_APIGEE_HOST
# Reasoning engine id of the RM Agent (else read from ../agent/.deployed.json)
# AGENT_ENGINE_ID=
# 1 = scripted traces, no cloud calls
DEMO_MOCK=0
# PORT=8080
