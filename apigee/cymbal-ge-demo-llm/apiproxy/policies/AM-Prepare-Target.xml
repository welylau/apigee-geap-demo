<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- model-routing.md target preparation: strip every caller credential BEFORE GoogleAccessToken inserts the
     runtime SA token; exact operation URL; no path/query copy. x-goog-user-project is removed so callers
     cannot redirect billing/quota to another project. -->
<AssignMessage continueOnError="false" enabled="true" name="AM-Prepare-Target">
    <Remove>
        <Headers>
            <Header name="Authorization"/>
            <Header name="x-api-key"/>
            <Header name="x-goog-api-key"/>
            <Header name="x-user-token"/>
            <Header name="x-goog-user-project"/>
            <Header name="Cookie"/>
        </Headers>
        <QueryParams/>
    </Remove>
    <Set>
        <Headers>
            <Header name="Content-Type">application/json</Header>
            <Header name="Host">{propertyset.llm.vertex_host}</Header>
        </Headers>
    </Set>
    <AssignVariable>
        <Name>target.copy.pathsuffix</Name>
        <Value>false</Value>
    </AssignVariable>
    <AssignVariable>
        <Name>target.copy.queryparams</Name>
        <Value>false</Value>
    </AssignVariable>
    <AssignVariable>
        <Name>target.url</Name>
        <Template>https://{propertyset.llm.vertex_host}/v1/projects/{propertyset.llm.vertex_project}/locations/global/publishers/google/models/{ai.upstream_model}:generateContent</Template>
    </AssignVariable>
    <IgnoreUnresolvedVariables>false</IgnoreUnresolvedVariables>
    <AssignTo createNew="false" transport="http" type="request"/>
</AssignMessage>
