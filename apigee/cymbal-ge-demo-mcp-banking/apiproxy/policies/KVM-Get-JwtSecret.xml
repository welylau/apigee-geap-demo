<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- HS256 secret from the encrypted, environment-scoped KVM created by scripts/setup-apigee.sh.
     The private. prefix keeps the value masked in debug sessions. -->
<KeyValueMapOperations continueOnError="false" enabled="true" name="KVM-Get-JwtSecret" mapIdentifier="cymbal-ge-demo-kvm">
    <Scope>environment</Scope>
    <ExpiryTimeInSecs>300</ExpiryTimeInSecs>
    <Get assignTo="private.cymbal.jwt_secret" index="1">
        <Key>
            <Parameter>jwt-hs256-secret</Parameter>
        </Key>
    </Get>
</KeyValueMapOperations>
