<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- Error flow: JSON-RPC error body from cymbal.reject or the native fault (no policy names, keys or faultstring).
     continueOnError so a script bug still yields AM-Error-Response. -->
<Javascript continueOnError="true" enabled="true" name="JS-Build-Error" timeLimit="200">
    <IncludeURL>jsc://mcp-lib.js</IncludeURL>
    <ResourceURL>jsc://build-error.js</ResourceURL>
</Javascript>
